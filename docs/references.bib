@inproceedings{yao_yes_2018,
  title      = {Yes, but {Did} {It} {Work}?: {Evaluating} {Variational} {Inference}},
  issn       = {2640-3498},
  shorttitle = {Yes, but {Did} {It} {Work}?},
  url        = {https://proceedings.mlr.press/v80/yao18a.html},
  abstract   = {While it{\textquoteright}s always possible to compute a variational approximation to a posterior distribution, it can be difficult to discover problems with this approximation. We propose two diagnostic algorithms to alleviate this problem. The Pareto-smoothed importance sampling (PSIS) diagnostic gives a goodness of fit measurement for joint distributions, while simultaneously improving the error in the estimate. The variational simulation-based calibration (VSBC) assesses the average performance of point estimates.},
