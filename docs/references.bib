@article{candes_stable_2006,
  title     = {Stable signal recovery from incomplete and inaccurate measurements},
  volume    = {59},
  copyright = {Copyright {\textcopyright} 2006 Wiley Periodicals, Inc.},
  issn      = {1097-0312},
  url       = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cpa.20124},
  doi       = {10.1002/cpa.20124},
  abstract  = {Suppose we wish to recover a vector x0 ? ??? (e.g., a digital signal or image) from incomplete and contaminated observations y = A x0 + e; A is an ?? {\texttimes} ?? matrix with far fewer rows than columns (?? << ??) and e is an error term. Is it possible to recover x0 accurately based on the data y? To recover x0, we consider the solution x\# to the ??1-regularization problem \$\${\textbackslash}rm {\textbackslash}min{\textbackslash}; {\textbar}x{\textbackslash}{\textbar}\_{\textbackslash}ell\_1 {\textbackslash}quad {\textbackslash}rm subject {\textbackslash}; to {\textbackslash}; {\textbackslash}{\textbar}Ax-y{\textbackslash}{\textbar}\_{\textbackslash}ell\_2 {\textbackslash}leq {\textbackslash}epsilon,\$\$ where $\epsilon$ is the size of the error term e. We show that if A obeys a uniform uncertainty principle (with unit-normed columns) and if the vector x0 is sufficiently sparse, then the solution is within the noise level \$\${\textbackslash}{\textbar}x{\textasciicircum}{\textbackslash}sharp - x\_0{\textbackslash}{\textbar}\_{\textbackslash}ell\_2 {\textbackslash}leq C {\textbackslash}cdot {\textbackslash}epsilon.\$\$ As a first example, suppose that A is a Gaussian random matrix; then stable recovery occurs for almost all such A's provided that the number of nonzeros of x0 is of about the same order as the number of observations. As a second instance, suppose one observes few Fourier samples of x0; then stable recovery occurs for almost any set of ?? coefficients provided that the number of nonzeros is of the order of ??/(log ??)6. In the case where the error term vanishes, the recovery is of course exact, and this work actually provides novel insights into the exact recovery phenomenon discussed in earlier papers. The methodology also explains why one can also very nearly recover approximately sparse signals. {\textcopyright} 2006 Wiley Periodicals, Inc.},
  language  = {en},
  number    = {8},
  urldate   = {2020-03-13},
  journal   = {Communications on Pure and Applied Mathematics},
  author    = {Cand{\`e}s, Emmanuel J. and Romberg, Justin K. and Tao, Terence},
  year      = {2006},
  eprint    = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/cpa.20124},
  pages     = {1207--1223}
}

